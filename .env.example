# Any OpenAI-compatible chat-completions provider works.
# Copy this file to .env.local and fill in your key. SERVER ONLY — never prefix these with NEXT_PUBLIC.

# --- Voice: Sarvam AI (Indian female voices, recommended) ---------------------
# Free key: https://dashboard.sarvam.ai — used for Hindi / Hinglish / English speech.
SARVAM_API_KEY=
TUTOR_SARVAM_MODEL=bulbul:v3
# Optional: point at a different Sarvam endpoint (e.g. a proxy).
# TUTOR_SARVAM_URL=https://api.sarvam.ai/text-to-speech

# --- Voice: Gemini TTS fallback ----------------------------------------------
# Only used when SARVAM_API_KEY is empty. Gemini's free tier allows very few clips
# per day, so spoken answers fall back to the browser's own voices quickly.
TUTOR_TTS_MODEL=gemini-3.8-flash-tts
# Set to "browser" to skip server speech entirely and use the OS voices.
# TUTOR_TTS_PROVIDER=

# --- Google Gemini (AI Studio key) -------------------------------------------
TUTOR_API_KEY=
TUTOR_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
TUTOR_MODEL=gemini-3.6-flash
# Used automatically if the primary model is overloaded or unavailable.
TUTOR_FALLBACK_MODEL=gemini-3.5-flash

# --- Gemini Live (real-time JARVIS voice sessions) ----------------------------
# Uses this key if set, otherwise TUTOR_API_KEY. Must be a Gemini AI
# Studio key; Live sessions are issued short-lived, configuration-limited tokens.
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.8-live

# --- Z.ai alternative ---------------------------------------------------------
# TUTOR_API_BASE=https://api.z.ai/api/paas/v4
# TUTOR_MODEL=glm-4-flash

# Notes
# - AI Studio now issues "AQ." keys (53 characters). Paste the key exactly; a stray
#   character at the end makes Google answer "API key not valid".
# - Model names change: if you get "no longer available to new users", list models with
#   curl "$TUTOR_API_BASE/models" -H "Authorization: Bearer $TUTOR_API_KEY" and pick a current one.
